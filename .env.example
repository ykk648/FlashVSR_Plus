# CUDA device visible to the API process. Keep one API worker per GPU.
FLASHVSR_PLUS_DEVICE=cuda:0
FLASHVSR_PLUS_HOST=0.0.0.0
FLASHVSR_PLUS_PORT=18303

# Restrict local input/output paths accepted by the API.
FLASHVSR_PLUS_ALLOWED_INPUT_ROOTS=./examples
FLASHVSR_PLUS_RUNTIME_ROOT=./runtime/api

# Checkpoint and service limits.
FLASHVSR_PLUS_MAX_FRAMES=300
FLASHVSR_PLUS_MAX_TARGET_PIXELS=8294400
FLASHVSR_PLUS_MAX_UPLOAD_BYTES=8589934592
FLASHVSR_PLUS_DEFAULT_MODE=turbo
FLASHVSR_PLUS_DECODE_EVERY=auto

# China mirror defaults. Domestic mirrors are direct. For a blocked external
# download only, run `FLASHVSR_USE_PROXY=1 <command>`; do not put proxy values
# in this file because that would proxy domestic PyPI/ModelScope traffic too.
HF_ENDPOINT=https://hf-mirror.com
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Optional proxy used only when FLASHVSR_USE_PROXY=1. Keep private proxy
# addresses in the local .env file; never commit them to a public repository.
# FLASHVSR_PROXY_URL=http://proxy-host:7890
